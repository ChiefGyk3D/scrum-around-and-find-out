# SPDX-License-Identifier: Apache-2.0
# The timer job, every ten seconds: put the nft table back if it was removed or changed from outside (no DNS), and when
# the hosts view is a minute old resolve the vendor host as root, validate every address, and swap the nft set and the
# hosts view. On a lookup problem it exits non-zero and leaves the previous set and hosts view in place.
[Unit]
Description=SAFO broker egress set refresh
Requires=safo-broker-egress.service
After=safo-broker-egress.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/safo-broker-egress tick
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/safo/egress
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
