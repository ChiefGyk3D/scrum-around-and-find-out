# Installed by root to /etc/systemd/system/. Loads the egress rules for the broker's service user and fills the vendor
# address set and the hosts view once; the timer keeps them fresh. The broker requires this unit and will not start
# without it. Runs as root with only CAP_NET_ADMIN; the code is the signed release.
[Unit]
Description=SAFO broker egress rules
Before=safo-broker.service
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/safo-broker/current/venv/bin/python -I -m safo.broker.egress load --rules /opt/safo-broker/current/meta/packaging/nftables/safo-broker.nft
ExecStart=-/opt/safo-broker/current/venv/bin/python -I -m safo.broker.egress refresh
ExecStop=/opt/safo-broker/current/venv/bin/python -I -m safo.broker.egress unload
TimeoutStartSec=60s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/safo/egress
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
