{
  "task": "issue-triage",
  "input": "Labels: bug, flaky-test, chore, feature.\nEpics: E-ci, E-sync, E-ui.\nRule: a failure that disappears on rerun with no user-visible symptom is flaky-test, not bug.\nIssue: tests/test_sync.py::test_retry fails about 1 run in 8 on CI and passes locally and on rerun. Nobody has reported a sync problem in production.",
  "facts": [
    {
      "text": "\"label\": \"flaky-test\"",
      "variants": [
        "\"label\"\\s*:\\s*\"flaky\\-test\""
      ]
    },
    {
      "text": "\"epic\": \"E-ci\"",
      "variants": [
        "\"epic\"\\s*:\\s*\"E\\-ci\""
      ]
    }
  ],
  "forbidden": [
    "\"label\"\\s*:\\s*\"(?!flaky\\-test\")",
    "\"epic\"\\s*:\\s*\"(?!E\\-ci\")"
  ],
  "max_chars": 200,
  "required_format": "json-object",
  "wrong": [
    "{\"label\": \"bug\", \"epic\": \"E-ci\"}",
    "{\"label\": \"flaky-test\", \"epic\": \"E-sync\"}"
  ],
  "correct_alts": [
    "{\"epic\": \"E-ci\", \"label\": \"flaky-test\"}",
    "```json\n{\n \"label\": \"flaky-test\",\n \"epic\": \"E-ci\"\n}\n```",
